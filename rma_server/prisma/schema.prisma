generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusSinistro {
  // ETAPA 2 - Sinistros aguardam comprovante antes da analise tecnica.
  PENDENTE_COMPROVACAO
  ABERTO
  EM_LABORATORIO
  // ETAPA 1 - Estado intermediário exigido pelo fluxo técnico.
  EM_REPARO
  REPARADO
  SUBSTITUIDO
  REPROVADO
}

// ETAPA 3 - Perfil e sessoes reais; nenhuma permissao vem do frontend.
enum PerfilUsuario {
  ATENDENTE
  TECNICO
  ADMINISTRADOR
}

// ETAPA 2 - Prazos padrao acordados para cada categoria de aparelho.
enum TipoDispositivo {
  FONE_COM_FIO
  CELULAR
  FONE_BLUETOOTH
  NOTEBOOK
}

enum TipoDefeito {
  TELA
  BATERIA
  PLACA
  CONECTOR
  SOFTWARE
}

// a ordem importa: o postgres ordena enum pela ordem que foi declarado,
// entao ordenar por severidade "asc" ja traz ALTA primeiro
enum Severidade {
  ALTA
  MEDIA
  BAIXA
}

model Sinistro {
  id               String         @id
  cliente          String
  dispositivo      String
  // ETAPA 2 - Campo opcional para preservar registros anteriores a migracao.
  tipoDispositivo  TipoDispositivo? @map("tipo_dispositivo")
  numeroSerie      String         @map("numero_serie")
  tipoDefeito      TipoDefeito    @map("tipo_defeito")
  descricaoDefeito String         @map("descricao_defeito")
  severidade       Severidade
  status           StatusSinistro @default(PENDENTE_COMPROVACAO)
  laudo            String?
  // ETAPA 3 - Um sinistro tem no maximo um tecnico responsavel.
  tecnicoResponsavelId String? @map("tecnico_responsavel_id")
  tecnicoResponsavel Usuario? @relation("ResponsavelSinistro", fields: [tecnicoResponsavelId], references: [id], onDelete: SetNull)
  atribuicoes       MovimentacaoTecnico[]
  // ETAPA 2 - Uma solicitacao pode ter um comprovante de compra.
  comprovante      ComprovanteGarantia?
  motivoReprovacao String? @map("motivo_reprovacao")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")

  @@index([numeroSerie])
  @@index([status])
  @@index([tecnicoResponsavelId])
  @@map("sinistros")
}

// ETAPA 2 - O arquivo fica no PostgreSQL, separado da listagem de sinistros.
// Assim, consultar a fila nao transfere PDFs/fotos desnecessariamente.
model ComprovanteGarantia {
  id                  String   @id @default(uuid())
  sinistroId          String   @unique @map("sinistro_id")
  nomeArquivo         String   @map("nome_arquivo")
  tipoMime            String   @map("tipo_mime")
  arquivo             Bytes
  dataCompra          DateTime @db.Date @map("data_compra")
  numeroDocumento     String?  @map("numero_documento")
  prazoGarantiaMeses  Int?     @map("prazo_garantia_meses")
  dataVencimento      DateTime? @db.Date @map("data_vencimento")
  confirmadoEm        DateTime? @map("confirmado_em")
  anexadoEm           DateTime @default(now()) @map("anexado_em")
  sinistro            Sinistro @relation(fields: [sinistroId], references: [id], onDelete: Cascade)

  @@map("comprovantes_garantia")
}

// ETAPA 3 - Usuarios cadastrados pelo administrador; senha apenas como hash.
model Usuario {
  id          String        @id @default(uuid())
  nome        String
  email       String        @unique
  senhaHash   String        @map("senha_hash")
  perfil      PerfilUsuario
  ativo       Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  sinistros   Sinistro[]    @relation("ResponsavelSinistro")
  sessoes     Sessao[]
  historicoComoAnterior MovimentacaoTecnico[] @relation("TecnicoAnterior")
  historicoComoNovo     MovimentacaoTecnico[] @relation("TecnicoNovo")
  historicoComoAutor    MovimentacaoTecnico[] @relation("AutorMovimentacao")

  @@map("usuarios")
}

// ETAPA 3 - Tokens aleatorios sao armazenados somente como SHA-256.
model Sessao {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  tokenHash   String   @unique @map("token_hash")
  expiraEm    DateTime @map("expira_em")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
  @@map("sessoes")
}

// ETAPA 3 - Auditoria MINIMA da atribuicao/transferencia (audit log completo: etapa futura).
model MovimentacaoTecnico {
  id                 String   @id @default(uuid())
  sinistroId         String   @map("sinistro_id")
  responsavelAnteriorId String? @map("responsavel_anterior_id")
  responsavelNovoId  String   @map("responsavel_novo_id")
  autorId            String   @map("autor_id")
  justificativa      String
  criadoEm           DateTime @default(now()) @map("criado_em")
  sinistro           Sinistro @relation(fields: [sinistroId], references: [id], onDelete: Cascade)
  // ETAPA 3 - Chaves estrangeiras identificam os usuarios envolvidos na transferencia.
  responsavelAnterior Usuario? @relation("TecnicoAnterior", fields: [responsavelAnteriorId], references: [id], onDelete: Restrict)
  responsavelNovo Usuario @relation("TecnicoNovo", fields: [responsavelNovoId], references: [id], onDelete: Restrict)
  autor Usuario @relation("AutorMovimentacao", fields: [autorId], references: [id], onDelete: Restrict)
  @@index([sinistroId])
  @@map("movimentacoes_tecnico")
}
