{
  "folders": [
    {
      "name": "Project Root",
      "path": ".",
    },
    {
      "name": "Backend (NestJS)",
      "path": "rma_server",
    },
    {
      "name": "Frontend (Next.js)",
      "path": "rma_client",
    },
  ],
  "settings": {
    /* --- Terminal e Ambiente Portátil --- */
    "terminal.integrated.defaultProfile.windows": "Sistema PowerShell",
    "terminal.integrated.profiles.windows": {
      "Sistema PowerShell": {
        "source": "PowerShell",
        "args": [
          "-NoExit",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          ". '${workspaceFolder:Project Root}\\powershell.ps1'",
        ],
      },
      "Git Bash": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      },
    },
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.fontSize": 18,

    /* --- Formatação Automática (Prettier & ESLint) --- */
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit",
    },
    "eslint.enable": true,
    "eslint.format.enable": false,
    "files.autoSave": "onFocusChange",
    "files.eol": "\n",
    "prettier.endOfLine": "lf",

    /* --- Formatação Específica por Linguagem --- */
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },

    /* --- Layout e Interface --- */
    "window.zoomLevel": 0,
    "editor.fontSize": 18,
    "editor.suggestFontSize": 18,
    "debug.console.fontSize": 18,
    "editor.minimap.enabled": false,
    "workbench.startupEditor": "newUntitledFile",
    "workbench.editor.labelFormat": "short",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.list.smoothScrolling": true,
    "workbench.localHistory.enabled": true,
    "workbench.layoutControl.enabled": false,
    "explorer.confirmDelete": true,
    "explorer.compactFolders": false,
    "breadcrumbs.enabled": false,

    /* --- Comportamento do Editor --- */
    "editor.largeFileOptimizations": true,
    "editor.renderControlCharacters": true,
    "editor.tabSize": 2,
    "editor.renderLineHighlight": "gutter",
    "editor.rulers": [120],
    "editor.detectIndentation": true,
    "editor.snippetSuggestions": "bottom",
    "editor.wordBasedSuggestions": "off",
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": true,
    },
    "editor.quickSuggestionsDelay": 1,
    "editor.suggestOnTriggerCharacters": false,
    "editor.parameterHints.enabled": false,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.fastScrollSensitivity": 4,
    "editor.smoothScrolling": true,
    "editor.mouseWheelZoom": true,
    "editor.fontLigatures": true,
    "editor.linkedEditing": true,
    "editor.accessibilitySupport": "off",
    "editor.renderWhitespace": "none",
    "editor.glyphMargin": true,
    "editor.inlineSuggest.enabled": true,
    "editor.stickyScroll.enabled": false,

    /* --- Git --- */
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "never",
    "diffEditor.ignoreTrimWhitespace": true,
    "powershell.scriptAnalysis.settingsPath": "",
    "powershell.scriptAnalysis.enable": false,
  },
  "extensions": {
    "recommendations": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"],
  },
}
